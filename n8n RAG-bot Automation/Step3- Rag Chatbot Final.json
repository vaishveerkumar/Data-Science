    {
      "parameters": {
        "jsCode": "const points = $('Count Topics').item.json.result.points || [];\nconst count = points.length;\nconst topic = $('Extract Topic').item.json.message.content.trim();\n\nif (count === 0) {\n  return {\n    json: {\n      message: {\n        role: \"assistant\",\n        content: `No articles found about ${topic} in my database.`\n      }\n    }\n  };\n}\n\nconst articles = points.map(r => \n  `- [${r.payload.title}](${r.payload.url}) by ${r.payload.author}`\n).join('\\n');\n\nreturn {\n  json: {\n    message: {\n      role: \"assistant\",\n      content: `I found ${count} article(s) about ${topic}:\\n\\n${articles}`\n    }\n  }\n};"
      },
