        "jsonBody": "={\n  \"filter\": {\n    \"must\": [\n      {\n        \"key\": \"topic\",\n        \"match\": {\n          \"value\": \"{{ $json.message.content.trim() }}\"\n        }\n      }\n    ]\n  },\n  \"limit\": 100,\n  \"with_payload\": true,\n  \"with_vector\": false\n}",
